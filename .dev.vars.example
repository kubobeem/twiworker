# ======================================================
# twiworker — ローカル開発用 環境変数
# ======================================================
# このファイルを .dev.vars にコピーして実際の値に置き換えてください。
# .dev.vars は gitignore されているので commit されません。
#
# TWITTER_COOKIES の JSON 形式:
# {
#   "auth_token": "...",
#   "ct0": "...",
#   "twid": "u%3D1234567890",
#   "kdt": "...",
#   "lang": "ja",
#   "_twitter_sess": "..."
# }
# ======================================================

TWITTER_COOKIES='{"auth_token":"","ct0":"","twid":"","kdt":"","lang":"ja","_twitter_sess":""}'
ACCOUNT_USERNAME=""
SITE_URL="http://localhost:8788"
